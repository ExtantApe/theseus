{
  "permissions": {
    "allow": [
      "Bash(python3 engine/tools/imsg.py:*)",
      "Bash(python3 engine/tools/mail.py:*)",
      "Bash(python3 engine/tools/notes.py:*)",
      "Bash(python3 engine/tools/alarms.py:*)",
      "Bash(python3 engine/tools/things_export.py:*)",
      "Bash(python3 engine/tools/schedule.py:*)",
      "Bash(python3 engine/tools/app_edits.py:*)",
      "Bash(bin/ek:*)",
      "Bash(ariadne count:*)",
      "Bash(ariadne rules:*)",
      "Read",
      "Edit(data/**)",
      "Edit(exports/**)",
      "Edit(briefings/**)",
      "Edit(profile.md)",
      "Edit(config.json)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:support.claude.com)",
      "WebSearch",
      "Bash(launchctl print:*)",
      "Bash(pgrep:*)",
      "mcp__clickup__clickup_update_task",
      "mcp__skylight__skylight_complete_chore",
      "mcp__skylight__skylight_complete_chore_instance",
      "mcp__skylight__skylight_uncomplete_chore",
      "mcp__skylight__skylight_create_chore",
      "mcp__skylight__skylight_create_recurring_chore",
      "mcp__skylight__skylight_update_chore",
      "mcp__skylight__skylight_create_task",
      "mcp__skylight__skylight_update_task",
      "mcp__skylight__skylight_add_list_item",
      "mcp__skylight__skylight_update_list_item",
      "mcp__skylight__skylight_move_list_item",
      "mcp__skylight__skylight_set_list_item_section"
    ],
    "ask": [
      "Bash(bin/ek delete:*)",
      "Edit(engine/**)",
      "Edit(CLAUDE.md)"
    ],
    "deny": [
      "Bash(osascript:*)",
      "Bash(shortcuts run:*)",
      "Bash(sqlite3 ~/Library/Messages:*)",
      "Edit(~/Library/Messages/**)",
      "Edit(~/Library/Mail/**)",
      "mcp__clickup__clickup_send_chat_message",
      "mcp__clickup__clickup_create_comment",
      "mcp__clickup__clickup_create_task_comment",
      "mcp__slack__slack_send_message",
      "mcp__slack__slack_post_message",
      "Read(~/.ssh/**)",
      "Read(.wall/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/Library/Keychains/**)",
      "Read(//**/.env)",
      "Read(//**/*.p12)",
      "Read(//**/signing.password)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/engine/tools/send_guard.py\" || exit 2"
          }
        ]
      }
    ]
  }
}
