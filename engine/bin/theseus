#!/bin/bash
# The theseus command. Follows its own symlink, so ~/.local/bin/theseus works from anywhere.
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; [[ "$src" == /* ]] || src="$dir/$src"
done
exec /usr/bin/python3 "$(cd "$(dirname "$src")/.." && pwd)/tools/cli.py" "$@"
